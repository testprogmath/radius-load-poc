{
  "name": "@flink/flinkord-cli",
  "version": "1.1.26",
  "description": "CLI tool for easy order generation and management",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/types/src/lib.d.ts",
  "bin": {
    "flinkord": "./dist/src/index.js"
  },
  "files": [
    "config",
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "npx tsc && chmod +x ./dist/src/index.js",
    "lint": "npx eslint",
    "postbuild": "npm link",
    "test": "jest dist/tests",
    "preinstall": "npx google-artifactregistry-auth",
    "release": "standard-version",
    "postrelease": "git push --follow-tags && npm publish"
  },
  "standard-version": {
    "scripts": {
      "postrelease": "git push --follow-tags origin main && npm publish"
    },
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "hidden": true
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goflink/flinkord-cli.git"
  },
  "keywords": [
    "order",
    "consumer"
  ],
  "author": "@annakhvorostianova",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/goflink/flinkord-cli/issues"
  },
  "homepage": "https://github.com/goflink/flinkord-cli#readme",
  "dependencies": {
    "@apollo/client": "^3.11.10",
    "@commercetools/platform-sdk": "^7.20.0",
    "@commercetools/sdk-client-v2": "^2.5.0",
    "@commercetools/sdk-middleware-auth": "^7.0.1",
    "@commercetools/sdk-middleware-http": "^7.0.4",
    "@flink/catalog": "^1.44.0",
    "@flink/hub-manager": "^1.49.0",
    "axios": "^1.7.8",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "config": "^3.3.12",
    "dotenv": "^16.4.5",
    "emojic": "^1.1.17",
    "figlet": "^1.8.0",
    "find-up": "^3.0.0",
    "fix-esm": "^1.0.1",
    "gradient-string": "^2.0.2",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "inquirer": "^8.2.5",
    "node-fetch": "^3.3.2",
    "typescript": "^5.7.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cli-spinner": "^0.2.3",
    "@types/config": "^3.3.5",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.9",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "eslint": "^8.41.0",
    "eslint-plugin-promise": "^6.2.0",
    "jest": "^29.7.0",
    "standard-version": "^9.5.0",
    "swagger-typescript-api": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  }
}
