{
  "name": "@flink/flinkord-cli",
  "version": "1.1.44",
  "description": "CLI tool for easy order generation and management",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/types/src/lib.d.ts",
  "bin": {
    "flinkord": "./dist/src/index.js"
  },
  "files": [
    "config",
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "NODE_NO_WARNINGS=1 npx tsc && chmod +x ./dist/src/index.js",
    "lint": "npx eslint",
    "postbuild": "npm link",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "preinstall": "npx google-artifactregistry-auth",
    "release": "standard-version",
    "postrelease": "git push --follow-tags && npm publish"
  },
  "standard-version": {
    "scripts": {
      "postrelease": "git push --follow-tags origin main && npm publish"
    },
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "hidden": true
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goflink/flinkord-cli.git"
  },
  "keywords": [
    "order",
    "consumer"
  ],
  "author": "@annakhvorostianova",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/goflink/flinkord-cli/issues"
  },
  "homepage": "https://github.com/goflink/flinkord-cli#readme",
  "dependencies": {
    "@apollo/client": "^3.12.6",
    "@commercetools/platform-sdk": "^7.23.0",
    "@commercetools/sdk-client-v2": "^2.5.0",
    "@commercetools/sdk-middleware-auth": "^7.0.1",
    "@commercetools/sdk-middleware-http": "^7.0.4",
    "@flink/hub-manager": "^1.52.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "ajv": "^8.17.1",
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "cli-spinner": "^0.2.10",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "emojic": "^1.1.17",
    "eslint-plugin-promise": "^7.2.1",
    "figlet": "^1.8.0",
    "find-up": "^7.0.0",
    "fix-esm": "^1.0.1",
    "gradient-string": "^3.0.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "inquirer": "^12.3.2",
    "jsonfile": "^6.1.0",
    "node-fetch": "^3.3.2",
    "strip-ansi": "^7.1.0",
    "uri-js": "^4.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cli-spinner": "^0.2.3",
    "@types/config": "^3.3.5",
    "@types/figlet": "^1.7.0",
    "@types/find-up": "^4.0.2",
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/jsonfile": "^6.1.4",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
