{
  "name": "@flink/flinkord-cli",
  "version": "2.0.0",
  "description": "CLI tool for easy order generation and management",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/types/src/index.d.ts",
  "bin": {
    "flinkord": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "config",
    "dist",
    "resources",
    "templates"
  ],
  "scripts": {
    "build": "npx tsc && [ -f ./dist/src/cli.js ] && chmod +x ./dist/src/cli.js",
    "lint": "npx eslint",
    "test": "vitest run",
    "release": "standard-version",
    "postrelease": "git push --follow-tags && npm publish"
  },
  "standard-version": {
    "scripts": {
      "postrelease": "git push --follow-tags origin main && npm publish"
    },
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "hidden": true
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goflink/flinkord-cli.git"
  },
  "keywords": [
    "order",
    "consumer"
  ],
  "author": "@annakhvorostianova",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/goflink/flinkord-cli/issues"
  },
  "homepage": "https://github.com/goflink/flinkord-cli#readme",
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@commercetools/platform-sdk": "^8.12.1",
    "@commercetools/sdk-client-v2": "^3.0.0",
    "@commercetools/ts-client": "^4.1.0",
    "@flink/hub-manager": "^1.52.2",
    "@google-cloud/storage": "^7.16.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.32.1",
    "axios": "^1.11.0",
    "chalk": "^5.4.1",
    "cli-spinners": "^3.2.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.0",
    "emojic": "^1.1.18",
    "eslint-plugin-promise": "^7.2.1",
    "figlet": "^1.8.2",
    "find-up": "^7.0.0",
    "fix-esm": "^1.0.1",
    "gradient-string": "^3.0.0",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "inquirer": "^12.7.0",
    "jsonfile": "^6.1.0",
    "lodash.merge": "^4.6.2",
    "node-fetch": "^3.3.2",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/find-up": "^4.0.2",
    "@types/gradient-string": "^1.1.6",
    "@types/inquirer": "^9.0.8",
    "@types/jsonfile": "^6.1.4",
    "@types/lodash.camelcase": "^4.3.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^24.0.15",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.31.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
