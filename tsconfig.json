{
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "declarationDir": "dist/types",
    "typeRoots": ["./node_modules/@types", "./types"],
    "outDir": "dist",
    "strict": true,
    "target": "es2020",
    "module": "NodeNext",
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "allowJs": true,
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.json",
    "index.d.ts"
  ]
}