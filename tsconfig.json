{
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "declarationDir": "dist/types",
    "rootDirs": [
      "src",
      "tests"
    ],
    //    "typeRoots": [".", "./dist/types/src/"],
    "outDir": "dist",
    "strict": true,
    "target": "es6",
    "module": "commonjs",
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "index.d.ts"
  ]
}
