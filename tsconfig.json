{
  "compilerOptions": {
    "skipLibCheck": true,
    "rootDirs": [
      "src",
      "tests"
    ],
    "outDir": "dist",
    "strict": true,
    "target": "es6",
    "module": "commonjs",
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
